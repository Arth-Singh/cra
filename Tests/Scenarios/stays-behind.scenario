# A test copy of Cra runs behind the apps of whoever runs the tests, on their own Mac too
# (CRA_TEST_BACKGROUND, every scenario), and never comes to the front: scripts/scenario.sh fails a
# run whose Cra was ever the front app. Until 8 Nov 2026 New Window and every Little Window brought
# the test copy forward by themselves, so a click or key press meant for the user's own Cra could
# land in a test window. The command bar and the cra:// commands already stayed behind.
budget rss=700 stalls50=10
cra://open?url=${PAGE}?n=first
expect-log loaded 127\.0\.0\.1 \(HTTP 200\)
cra://action/newWindow
wait 2
cra://debug?browserWindows=two
expect-log browser windows two: count=2
cra://open?url=${PAGE}?n=little&little=1
wait 3
cra://debug?cdp=Runtime.evaluate&target=little&params={"expression":"'little:'+location.search"}
expect-log Cra cdp Runtime.evaluate .*"value":"little:\?n=little"
cra://commandbar
wait 1
cra://dismiss
wait 2
